set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES LABYRINTH_ZIG LABYRINTH_LLVM_DIR)
set(CMAKE_CXX_COMPILER "${LABYRINTH_ZIG}" c++ -target x86_64-windows-gnu)
set(CMAKE_RC_COMPILER "${LABYRINTH_LLVM_DIR}/bin/llvm-windres")
set(CMAKE_RC_FLAGS_INIT "--target=pe-x86-64")
set(CMAKE_AR "${LABYRINTH_LLVM_DIR}/bin/llvm-ar")
set(CMAKE_RANLIB "${LABYRINTH_LLVM_DIR}/bin/llvm-ranlib")
